font-size:26px;line-height:31px;color:#e9cd8d}.status{font-size:8px;color:#c7d7bc;white-space:nowrap}.pending{position:absolute;left:500px;top:176px;display:flex;align-items:center;gap:6px;font-size:9px}.pending image,.pending img{width:24px;height:33px}.waits{position:absolute;left:126px;bottom:68px;max-width:160px;font-size:9px;color:#f6dfa2}.wait-grid{display:flex;flex-wrap:wrap;gap:3px;margin-top:3px;max-height:100px;overflow:auto}.wait-grid>view,.wait-grid>div{display:flex;flex-direction:column;align-items:center}.wait-grid image,.wait-grid img{width:18px;height:25px}.wait-grid text,.wait-grid small{font-size:7px}.lock-note{position:absolute;bottom:119px;left:13px;font-size:9px;color:#ffd491}.action-row{position:absolute;bottom:105px;left:270px;width:310px;display:flex;gap:8px;justify-content:center;z-index:5}.response{width:46px;height:44px;padding:8px;font-size:22px;background:#f5e2a6;color:#66501d;border-radius:50%;box-shadow:0 2px 0 #90763b}.response.win{background:#eeb457;color:#5d3219}.own-info{position:absolute;bottom:69px;left:280px;display:flex;align-items:center;gap:12px;font-size:10px}.own-info button{font-size:10px;padding:6px 9px;background:#315f44;color:#eadbaf}.own-rail{position:absolute;left:82px;right:82px;bottom:17px;display:flex;justify-content:center;align-items:flex-end;gap:12px;min-height:50px}.hand{display:flex;gap:2px;align-items:flex-end}.hand-tile{position:relative;width:32px;height:45px;cursor:pointer;flex-shrink:0;touch-action:manipulation}.hand-tile image,.hand-tile img{width:32px;height:44px;object-fit:fill;filter:drop-shadow(0 3px 0 #b1b391)}.hand-tile.selected{transform:translateY(-12px)}.hand-tile text,.hand-tile em{position:absolute;right:0;top:0;font-style:normal;background:#c5a656;color:#fff;font-size:7px;padding:2px}.own-melds{display:flex;gap:8px;align-items:flex-end}.meld{display:flex;flex-direction:column;align-items:center;flex-shrink:0}.meld-tiles{display:flex;gap:1px;align-items:flex-end}.meld-slot{width:21px;height:29px;position:relative;overflow:hidden;flex-shrink:0}.meld-slot image,.meld-slot img{width:21px;height:29px;transform-origin:0 0}.meld-slot.sideways{width:29px;height:21px}.meld-slot.sideways image,.meld-slot.sideways img{transform:translateY(21px) rotate(-90deg)}.meld>text,.meld>small{font-size:6px;line-height:11px;color:#d2d8b7}.shade{position:absolute;inset:0;background:#06261eb5;z-index:10;display:flex;justify-content:center;align-items:center}.choice-sheet,.result-sheet{width:300px;max-height:352px;background:#fffdf1;border-radius:17px;padding:20px;color:#284137;display:flex;flex-direction:column;gap:8px}.sheet-title{font-size:20px;text-align:center;margin-bottom:4px;display:block}.choice-list{max-height:210px;overflow:auto}.choice-list button{display:block;width:100%;margin:5px 0}.result-sheet>text{text-align:center;font-size:12px}.result-row{display:flex;justify-content:space-between;border-bottom:1px solid #e2e5d8;padding:8px;font-size:14px}.positive{color:#b0782f}.result-buttons{display:flex;gap:8px;margin-top:8px}.result-buttons button{flex:1;font-size:12px}.error-banner{position:absolute;top:35px;left:180px;width:480px;z-index:20;padding:8px;background:#633923;color:#fff;font-size:11px;border-radius:7px;display:flex;align-items:center;gap:8px}.error-banner button{padding:5px;white-space:nowrap}.loading{padding:50px;color:#fff}.loading button{margin-top:20px}.rotate-prompt{display:none}

.scene-picker{font-size:12px;color:#52715d;margin-top:18px;padding:10px;background:#f1f3e9;border-radius:8px}

/* Fixed-capacity seat lanes: transforms must not depend on tile count. */
.opponent.top{top:33px}
.river{width:134px;height:59px}
.river image,.river img{width:14px;height:19px}
.river.top{left:341px;top:119px}
.river.bottom{left:341px;top:224px;bottom:auto}
.river.left{left:258px;top:122px;transform-origin:0 0}
.river.right{left:576px;right:auto;top:256px;transform-origin:0 0}
.flowers{width:143px;height:29px}
.flowers image,.flowers img{width:10px;height:14px}
.flowers.top{left:341px;top:86px}
.flowers.bottom{left:500px;top:285px;bottom:auto}
.flowers.left{left:154px;top:118px;transform-origin:0 0}
.flowers.right{left:680px;right:auto;top:261px;transform-origin:0 0}
.center{top:179px}
.wall{font-size:23px;line-height:26px}
.own-info{gap:6px}
.own-info .retained{background:#cfba79;color:#254434}
.connection-page{max-width:460px;margin:auto;padding:60px 26px 32px}
.connection-back{background:transparent;padding:12px 0;margin-bottom:20px;font-size:14px}
.connection-help{font-size:12px;color:#748170;line-height:1.8;margin:20px 0}
.connection-page label{display:block;font-size:13px;margin:22px 0 9px}
.connection-input{box-sizing:border-box;width:100%;height:48px;padding:10px 12px;border:1px solid #cdd7c7;background:#fffdf6;border-radius:9px;font-size:13px}
.connection-page>.primary,.connection-page>.secondary{margin-top:15px;width:100%}
.connection-message{font-size:13px;color:#a44725;line-height:1.7;margin-top:18px}
.connection-message.success{color:#25614c}
.connection-link{padding:10px 16px;background:transparent;font-size:11px;color:#718170}
/* WeChat native buttons have a block-width default absent in browser buttons. */
button{width:auto;min-width:0;flex-shrink:0}
.table-top button,.own-info button{margin:0;flex:none}

.result-sheet>.sheet-title{font-size:20px}
.friend-card{margin-bottom:18px}.room-input{box-sizing:border-box;border:1px solid #d8dfd0;border-radius:8px;background:#fffdf6;height:43px;padding:10px 12px;font-size:13px;width:100%;margin:10px 0}
.join-row{display:flex;align-items:center;gap:8px}.join-row .room-input{flex:1;min-width:0}.join-row button{width:auto;white-space:nowrap;font-size:12px;margin-top:0}
.shared-room-page{padding:65px 25px 28px;max-width:450px;margin:auto}.room-code-label{font-size:12px;color:#84917e;margin-top:26px}.room-code{font-size:40px;letter-spacing:7px;line-height:1.5;color:#28563f;margin-bottom:6px}
.shared-seats{display:flex;flex-wrap:wrap;gap:12px;margin:25px 0}.shared-seat{width:calc(50% - 6px);background:#fffdf4;border:1px solid #d7dfd0;border-radius:15px;padding:15px 12px;min-height:118px}.shared-seat.mine{border-color:#478064}.seat-symbol{width:32px;height:32px;background:#e4ecdd;border-radius:50%;text-align:center;line-height:32px;font-size:14px;margin-bottom:8px}.seat-person{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.seat-presence{font-size:11px;color:#809174;margin-top:6px}.shared-room-page>button,.shared-room-page>view>button,.shared-room-page>div>button{display:block;width:100%;margin-top:12px}.room-notice{font-size:12px;color:#9c7136;line-height:1.7;margin-bottom:12px}
.flower-tools{display:flex;align-items:center;justify-content:space-between;margin:13px 0;font-size:12px;color:#6d7e68}
.flower-tools .flower-all{width:auto;min-width:0;margin:0;padding:8px 14px;font-size:12px;min-height:36px}
.flower-scroll{max-height:150px;overflow:auto}
.flower-options{display:flex;flex-wrap:wrap;gap:8px;padding:4px}
.flower-options .flower-option{position:relative;width:48px;min-width:0;height:62px;margin:0;padding:5px;border:2px solid transparent;background:#e9ecdf;flex:0 0 48px;border-radius:8px}
.flower-options .flower-face{display:block;width:34px;height:46px;margin:auto}
.flower-option.picked{border-color:#337653;background:#d9e9cf}
.flower-option .flower-pickmark{position:absolute;right:0;top:0;width:15px;height:15px;border-radius:0 4px 0 4px;background:#337653;color:white;font-size:11px;text-align:center;line-height:15px}
.flower-limit{display:block;font-size:11px;color:#a44725;line-height:1.6;margin-top:8px}
.flower-confirm{display:flex;gap:8px;margin-top:16px}
.flower-confirm .flower-confirm-button{flex:1;min-width:0;font-size:12px;min-height:42px;padding:10px 8px}
.table-top .table-sound{width:auto;min-width:0;margin:0;flex:none}
.audio-note{position:absolute;right:18px;top:35px;z-index:4;font-size:9px;color:#f0d58e;max-width:220px;line-height:1.6}
