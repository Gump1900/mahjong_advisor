page,body{margin:0;color:#213b32;background:#f3f2e9;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}view,button{box-sizing:border-box}button{font:inherit;line-height:1.3;border:0;border-radius:10px;padding:11px 17px;background:#e5eade;color:#29473b;margin:0;cursor:pointer}button::after{border:0}button[disabled]{opacity:.5}image{display:block}button.primary{background:#25614c;color:#fff}.secondary{background:transparent;border:1px solid #c9d2c5}.home{max-width:500px;margin:auto;padding:62px 25px 24px;min-height:100vh}.home-brand{font-size:18px;letter-spacing:3px;font-weight:600}.home-eyebrow{color:#6e8977;font-size:10px;letter-spacing:3px;margin-top:45px}.home-title{white-space:pre-line;font-size:48px;line-height:1.3;font-family:Georgia,"Songti SC",serif;margin-top:15px}.home-copy{font-size:13px;color:#708173;margin-top:16px}.hero-tiles{height:140px;display:flex;align-items:center;justify-content:center;gap:8px}.hero-tiles image,.hero-tiles img{width:50px;height:70px;object-fit:fill;filter:drop-shadow(0 7px 4px #173e2325);transform:rotate(-9deg)}.hero-tiles image:nth-child(2),.hero-tiles img:nth-child(2){transform:translateY(-9px)}.hero-tiles image:last-child,.hero-tiles img:last-child{transform:rotate(9deg)}.room-card{background:#fffdf5;border:1px solid #dce3d6;border-radius:20px;padding:22px}.card-title{font-size:20px;font-weight:600;margin-bottom:9px}.muted{font-size:12px;color:#78867b}.seat-line{font-size:13px;margin:25px 0 20px;color:#4c6f5b}.room-card button{width:100%;margin-top:8px;min-height:46px}.home-foot{font-size:11px;line-height:1.6;text-align:center;color:#889589;margin-top:28px}.error-message{color:#a44725;font-size:12px;line-height:1.7;margin-top:18px}.table-viewport{position:fixed;inset:0;background:#102e27;overflow:hidden}.board{position:absolute;width:844px;height:390px;transform-origin:0 0;background:radial-gradient(ellipse at center,#28604d,#174836 88%);color:#f1ebce;overflow:hidden;border:5px solid #63815a;box-sizing:borde